{% extends "login/base.html.twig" %}

{% block css %}
{{ parent() }}
<style type="text/css">
/* Custom CSS to be moved after the BS5 migration, this helps responsiveness */
/*
 * max-width:36% is only safe once the viewport itself is wide enough that 36%
 * still leaves room for the col-sm-4/col label+input split beneath it — that
 * split lays out side-by-side starting at the (viewport-based) sm breakpoint
 * regardless of how narrow the container is. At exactly 768px, 36% yields a
 * ~276px container and the label column collapses to ~92px, too narrow for
 * "Password"/"Language" and causing label/input overlap. Moving the trigger
 * to the lg breakpoint (992px) keeps the intended narrow band on genuinely
 * wide desktop screens while letting tablet widths use the full band, which
 * has ample room for the label+input row at those sizes.
 */
@media (min-width: 992px) {
    .vertical-band {
        max-width: 36%;
    }
}
</style>
{% endblock %}

{% block content %}
<div class="vh-100 p-3 p-md-5 d-flex flex-column justify-content-center mx-auto vertical-band">
    <div class="align-items-center">
        {% include "login/partials/html/primary_logo.html.twig" %}
        {% include "login/partials/html/login_details.html.twig" %}
        {% include "login/partials/html/acknowledgements.html.twig" %}
        {{ divApp }}
    </div>
    {% if displayGoogleSignin %}
    <div class="d-none">
        <div class="form-group">
            <input type="hidden" id="used-google-signin" name="used_google_signin" value="">
            <input type="hidden" id="google-signin-token" name="google_signin_token" value="">
            <div id="google-signin" onclick="return do_google_signin();">
                <!-- This message is displayed if the google platform API cannot render the button -->
                <span id="google-signin-service-unreachable-alert" style="d-none">
                    {{ "Google Sign-In is enabled but the service is unreachable."|xlt }}
                </span>
            </div>
            <div id="google-signout">
                <a href="#" onclick="signOut();">{{ "Sign out"|xlt }}</a>
            </div>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
