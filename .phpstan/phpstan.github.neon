includes:
  - extension.neon
  - baseline/loader.php
parameters:
  reportUnmatchedIgnoredErrors: true
  strictRules:
    allRules: false
    disallowedEmpty: true
  scanDirectories:
    - ../vendor/adodb/adodb-php
  scanFiles:
    - ../vendor/phpunit/phpunit/src/Framework/TestCase.php
  excludePaths:
    - ../tests/Rector
    # Fixture files for SqlReservedWordRuleTest deliberately contain SQL
    # patterns the rule should flag; excluding them keeps full-codebase
    # PHPStan runs from reporting those intentional bugs.
    - ../tests/Tests/Isolated/PHPStan/Sql/data
    # Fixture files for the ThiqaBranding guardrail rule tests deliberately
    # declare the OpenEMR\Modules\ThiqaBranding\ namespace and violate
    # WP-2.7's constraints; excluding them keeps full-codebase PHPStan runs
    # from reporting those intentional violations.
    - ../tests/Tests/Isolated/PHPStan/ThiqaBranding/data
